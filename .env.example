# SETU environment (spec §17). Copy to `.env` and fill in.
# NOTE: ANTHROPIC_API_KEY is app-side ONLY. Do NOT export it in your Claude Code shell (§14).

ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

FACE_MODEL=buffalo_l
TTL_DAYS=45

# Set true to force the edge/offline path (local FAISS only; no Supabase). Spec §13.
OFFLINE_MODE=false
